# Scholarship RAG backend environment template
# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.

# PostgreSQL with the pgvector extension enabled
DB_URL=jdbc:postgresql://localhost:5432/scholarship_rag
DB_USER=postgres
DB_PASSWORD=change-me

# Redis (conversation and semantic memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_HOURS=24

# Primary LLM: Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional fallback: Google Gemini (leave the key blank to skip)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional fallback: OpenRouter (leave the key blank to skip)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_MAX_TOKENS=4096

# Retrieval tuning
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_DISTANCE=1.0
SEMANTIC_MEMORY_MAX_DISTANCE=0.30

# Chunking review output
CHUNKING_ENABLED=true
CHUNKING_OUTPUT=.chunking/chunk-review.txt
CHUNKING_MARKER=.chunking/.corpus-chunked
CHUNKING_FORCE=false

# Set INGEST_ENABLED=true once to load the corpus and refresh verified
# scholarship_metadata. Existing chunks are skipped unless INGEST_FORCE=true.
INGEST_ENABLED=true
INGEST_FORCE=false
